# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Configuration (IMPORTANT: Change these in production!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_use_at_least_32_characters
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Frontend Configuration
# Add all allowed frontend URLs separated by commas for production
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Security Configuration
# Rate Limiting (requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Email Configuration (Optional - for future use)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# WhatsApp Configuration (Optional - for future use)
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_TOKEN=your_whatsapp_business_token
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token

# Admin Default Credentials (for seed script)
ADMIN_EMAIL=portfolioadmin@rawaha.me
ADMIN_PASSWORD=rawahamr11
ADMIN_NAME=M.Rawaha
